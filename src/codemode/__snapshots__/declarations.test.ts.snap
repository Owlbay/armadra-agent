// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildDeclarationBlock > 内置工具的声明快照（缺省预算全部内联，按名排序） 1`] = `
"interface BashResult { output: string; truncated: boolean; fullOutputPath?: string; exitCode: number; wallTimeMs: number }
declare const tools: {
  /** Run a shell command; stdout+stderr combined, keeps the last 2000 lines / 50 KB (full output saved). Timeout 120 s, max 600 s. background:true gives a job id for {job, action}. */
  bash(args: {
    command?: string;
    timeoutMs?: number;
    /** Default: session cwd */
    cwd?: string;
    description?: string;
    background?: boolean;
    job?: string;
    action?: "wait" | "output" | "stop";
  }): Promise<BashResult>;
  /** Replace text in a file (read it first). Give all changes to a file as edits[] in one call; each oldText matches the original file and must be unique (unless replaceAll), short and non-overlapping. */
  edit(args: {
    path: string;
    edits: {
      /** Exact text to replace */
      oldText: string;
      newText: string;
    }[];
    replaceAll?: boolean;
  }): Promise<string>;
  /** Find files by glob (\`**\`, \`*\`, \`?\`, \`[...]\`, \`{a,b}\`, leading \`!\` excludes). Patterns without \`/\` match names at any depth. Respects .gitignore/.ignore; newest first. */
  glob(args: {
    /** e.g. **\\/*.ts */
    pattern: string;
    /** Directory (default: cwd) */
    path?: string;
    /** Default 1000 */
    limit?: number;
  }): Promise<string>;
  /** Search file contents by JS regex. Respects .gitignore/.ignore; skips binary and >2 MB files. Output: \`path:line: text\`. */
  grep(args: {
    pattern: string;
    /** File or dir (default: cwd) */
    path?: string;
    /** File filter, e.g. *.ts */
    glob?: string;
    ignoreCase?: boolean;
    literal?: boolean;
    /** 0-5 lines */
    context?: number;
    /** Default 100 */
    limit?: number;
  }): Promise<string>;
  /** List a directory: subdirectories end with \`/\`, files show their size, symlinks show their target. Includes dotfiles. Default limit 500. */
  ls(args: {
    /** Directory (default: cwd) */
    path?: string;
    /** Maximum entries (default 500) */
    limit?: number;
  }): Promise<string>;
  /** Read a file. Text comes with line numbers (cat -n), limited to 2000 lines or 50.0 KB; page with offset/limit. Images (png, jpg, gif, webp) come as attachments. */
  read(args: {
    /** Absolute or relative to cwd */
    path: string;
    /** First line (1-based) */
    offset?: number;
    /** Max lines */
    limit?: number;
  }): Promise<string>;
  /**
   * Delegate to a sub-agent (fresh context; give full instructions). Returns its final report. Tasks in one reply run in parallel; writers should use isolation worktree. background: returns a taskId now (see task_ctl); taskId: continue that task.
   * Agents:
   * - general: General-purpose sub-agent (default): researches and changes code like you do.
   * - explore: Read-only search: locates files, symbols and code paths; returns paths with line numbers.
   * - plan: Read-only planner: returns a step-by-step plan with key files and trade-offs.
   */
  task(args: {
    prompt: string;
    /** Default general */
    agent?: string;
    description?: string;
    background?: boolean;
    taskId?: string;
    isolation?: "none" | "worktree";
    budgetUsd?: number;
    tools?: string[];
    model?: string;
    thinkingLevel?: "off" | "minimal" | "low" | "medium" | "high" | "xhigh";
    maxTurns?: number;
  }): Promise<string>;
  /** Manage sub-agent tasks started by task: list them, wait for one, stop it, read its output, or send it a follow-up message (runs in background). */
  task_ctl(args: {
    action: "list" | "wait" | "stop" | "output" | "send";
    /** Required except for list */
    taskId?: string;
    /** wait only (default 30000) */
    timeoutMs?: number;
    /** send only */
    prompt?: string;
  }): Promise<string>;
  /** Session task list: \`set\` replaces all items, \`update\` changes items by id (only given fields), \`get\` reads. */
  todo(args: {
    action: "set" | "update" | "get";
    items?: {
      id: string;
      text?: string;
      status?: "pending" | "in_progress" | "done";
      planStep?: string;
    }[];
  }): Promise<string>;
  /** Write a file, replacing its entire content; parent directories are created. An existing file must be read first. Prefer the edit tool for partial changes. */
  write(args: {
    /** File path, absolute or relative to cwd */
    path: string;
    /** Full new file content */
    content: string;
  }): Promise<string>;
};"
`;
