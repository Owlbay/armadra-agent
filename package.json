{
  "name": "@armadra/agent",
  "version": "0.2.0",
  "description": "可独立使用、可嵌入 Armadra 的编码 / 协调 Agent",
  "type": "module",
  "keywords": [
    "coding-agent",
    "agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "anthropic",
    "openai",
    "claude",
    "deepseek",
    "codemode",
    "prompt-cache",
    "sdk",
    "armadra"
  ],
  "homepage": "https://github.com/Owlbay/armadra-agent#readme",
  "bugs": {
    "url": "https://github.com/Owlbay/armadra-agent/issues"
  },
  "author": "YoVinchen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owlbay/armadra-agent.git"
  },
  "bin": {
    "ama": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./bundle": "./dist/bundle/ama.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/rpc.md",
    "docs/host-api.md",
    "docs/hooks.md",
    "docs/providers.md",
    "docs/codemode.md",
    "docs/tui.md",
    "docs/session-format.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/cli/main.js",
    "./dist/codemode/sandbox-entry.js",
    "./dist/bundle/*.cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:bundle",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:bundle": "node scripts/build-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "AMA_E2E=1 vitest run test/e2e",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check:deps": "node scripts/check-no-deps.mjs",
    "release:check": "node scripts/release-check.mjs",
    "bench:presets": "node scripts/bench-presets.mjs",
    "bench:cache": "node scripts/cache-experiment.mjs",
    "ci": "pnpm typecheck && pnpm fmt:check && pnpm check:deps && pnpm release:check && pnpm test && pnpm build && node dist/bundle/ama.cjs --version"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0"
}
